# Informational: the server reads shell environment variables, not this file.
REPROPACK_PORT=4317
# Defaults to .repropack in the project directory.
# REPROPACK_DATA_DIR=
# Optional explicit trusted Node/PostgreSQL application config. No auto-discovery.
# REPROPACK_APP_CONFIG=C:/path/to/your/application/repropack.json
# Required with a custom server application; get the ID from Account & team.
# REPROPACK_APP_TEAM_ID=
# Exact HTTPS origin for a proxy, or explicit loopback HTTP for local Docker port mappings.
# REPROPACK_PUBLIC_ORIGIN=https://repropack.example.com
# Defaults to 127.0.0.1; the container listens on 0.0.0.0 and Compose publishes loopback only.
# REPROPACK_LISTEN_HOST=127.0.0.1
# Disposable synthetic-only demo; always uses a fresh temporary directory.
# REPROPACK_DEMO=1
# Optional preview instance lifetime: 60000..7200000 ms.
# REPROPACK_DEMO_LIFETIME_MS=7200000
# Compose only: change both the mapped port and the exact local origin together.
# REPROPACK_HTTP_PORT=4318
# REPROPACK_PUBLIC_ORIGIN=http://127.0.0.1:4318
# Optional immutable LOCAL Linux Docker image ID for the built-in PostgreSQL scenario.
# Missing Docker/limits/image fails closed; it never runs the workload natively instead.
# REPROPACK_SANDBOX_IMAGE=sha256:<64-lowercase-hex>
# Optional account email: see docs/ACCOUNT-SECURITY.md. Keep actual credentials private.
# REPROPACK_SMTP_HOST=smtp.example.com
# REPROPACK_SMTP_PORT=587
# REPROPACK_SMTP_SECURE=0
# REPROPACK_SMTP_USER=
# REPROPACK_SMTP_PASSWORD=
# REPROPACK_MAIL_FROM=repropack@example.com
# Requires SMTP; gates all workspace access until email is verified.
# REPROPACK_REQUIRE_VERIFIED_EMAIL=1
